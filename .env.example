# --- LLM via the Respan gateway ----------------------------------------------
# One Respan key reaches OpenAI, Anthropic, Gemini and 1,000+ models through a
# single OpenAI-compatible endpoint. Keep the "openai/" prefix on the slugs.
LLM_PROVIDER=custom
LLM_ENDPOINT=https://api.respan.ai/api
LLM_API_KEY=<respan-key>
# gpt-4.1-mini was about 3.4x faster per extraction call than openai/gpt-5-mini.
LLM_MODEL=openai/gpt-4.1-mini

EMBEDDING_PROVIDER=custom
EMBEDDING_ENDPOINT=https://api.respan.ai/api
EMBEDDING_API_KEY=<same-respan-key>
EMBEDDING_MODEL=openai/text-embedding-3-large
EMBEDDING_DIMENSIONS=3072

# Same key for the agent's answer call and Respan tracing (OpenAI SDK base_url=https://api.respan.ai/api)
RESPAN_API_KEY=<respan-key>
# ANSWER_MODEL=gpt-4.1

# Prefer your own provider instead? Comment the block above and set, e.g.:
# LLM_API_KEY=sk-...
# LLM_PROVIDER=openai
# LLM_MODEL=openai/gpt-4.1-mini

# --- Company Brain -------------------------------------------------------------
# The values below run the synthetic sample (sample/raw: Alice and Bob at Acme Robotics).
# For your own data: BRAIN_RAW_DIR=data/raw, your own BRAIN_USERS, and remove BRAIN_NOW.
BRAIN_RAW_DIR=sample/raw
BRAIN_USERS="alice=alice@example.com,bob=bob@example.com"
# Pins "today" so the dated sample records fall inside the 3-day / 14-day windows.
BRAIN_NOW=2026-10-08T00:00:00+00:00
# Company name used in the agent's prompts.
BRAIN_COMPANY="Acme Robotics"
# Password Cognee stores for each local user; only used to log in to the local Cognee UI.
BRAIN_LOCAL_PASSWORD=change-me-local-only
# Content scope (brain/split.py): Linear teams to keep, and optional pins for older items.
# BRAIN_LINEAR_TEAMS="Product & Engineering,Operations"
# BRAIN_PINNED_TICKETS=ACME-210,ACME-231
# BRAIN_PINNED_TEXT=calibration|canary

# --- Scalekit AgentKit (Dashboard -> Developers -> API Credentials) ---------
# Live pulls only. Connections to create under AgentKit -> Connections:
# Slack, Linear, Notion, Granola. Set the names below if yours differ.
SCALEKIT_ENVIRONMENT_URL=https://<env>.scalekit.dev
SCALEKIT_CLIENT_ID=skc_...
SCALEKIT_CLIENT_SECRET=...
SCALEKIT_SLACK_CONNECTION=slack
SCALEKIT_LINEAR_CONNECTION=linear
SCALEKIT_NOTION_CONNECTION=notion
SCALEKIT_GRANOLA_CONNECTION=granola
# 1 also pulls Slack thread replies (one call per thread; hits rate limits fast).
# SLACK_FETCH_REPLIES=0
# Regex of Slack channel names to leave out of the pull.
# BRAIN_EXCLUDE_CHANNELS=

# --- Cognee -----------------------------------------------------------------
# Multi-user mode: per-user datasets, isolated graph + vector stores, shares.
# brain/memory.py forces this to true before Cognee is imported.
ENABLE_BACKEND_ACCESS_CONTROL=true
# brain/memory.py keeps all Cognee state in <repo>/.cognee_system and <repo>/.cognee_data.
# Override with ABSOLUTE paths only (Cognee rejects relative ones):
# SYSTEM_ROOT_DIRECTORY=/abs/path/.cognee_system
# DATA_ROOT_DIRECTORY=/abs/path/.cognee_data
